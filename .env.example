# Copy this file to .env and fill in real values. .env is git-ignored.

# Google Places API key (Places API must be enabled in Google Cloud Console).
# Used server-side only — never sent to the browser.
NUXT_GOOGLE_PLACES_API_KEY=

# Google Place ID for the business (found via the Place ID Finder tool).
# Not a secret, but overridable per environment if needed.
NUXT_GOOGLE_PLACE_ID=ChIJgXd7FILoDkcRl-n-f8aoc1c

# Shared secret required to call POST /api/opening-hours/refresh.
# Generate one with: openssl rand -hex 32
NUXT_REFRESH_SECRET=
