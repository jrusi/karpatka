# Copy this file to .env and fill in real values. .env is git-ignored.

# Google Places API key (Places API must be enabled in Google Cloud Console).
# Used server-side only — never sent to the browser.
NUXT_GOOGLE_PLACES_API_KEY=

# Google Place ID for the business (found via the Place ID Finder tool).
# Not a secret, but keep it out of checked-in files anyway — Netlify's
# build-time secrets scanner flags any configured env var's literal value
# if found in the repo or build output, regardless of sensitivity.
NUXT_GOOGLE_PLACE_ID=

# Shared secret required to call POST /api/opening-hours/refresh.
# Generate one with: openssl rand -hex 32
NUXT_REFRESH_SECRET=

# Only needed on Netlify — the deployed site's public URL, used by
# netlify/functions/daily-hours-refresh.ts to call the refresh endpoint.
# Netlify's own auto-injected URL var isn't reliably available inside
# scheduled functions, so this must be set explicitly in the Netlify UI.
SITE_URL=https://your-site.netlify.app
